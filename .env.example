# Copy this file to ".env" (the launcher does this automatically) and fill in values.
# ".env" is git-ignored. Never share its contents in chat, email or screenshots.

# Claude API key from https://console.anthropic.com (Settings > API keys)
ANTHROPIC_API_KEY=

# Model used for matching and drafting
CLAUDE_MODEL=claude-opus-5

# Monthly spending cap for the Claude API, in US dollars
MONTHLY_BUDGET_USD=50

# Gmail job-alert reader (used from stage S1). Use a Gmail *app password*, not your normal password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_LABEL=Job Alerts

# Commercial job aggregators scrape other sites. Keep false unless you decide otherwise.
ENABLE_AGGREGATORS=false

# Folder holding personal data (profile, database, generated documents). Default: ./private
CAREER_DATA_DIR=
